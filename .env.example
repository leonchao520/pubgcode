# PUBG 官方 API Key
# 申请地址: https://developer.pubg.com/
PUBG_API_KEY=your_pubg_api_key_here

# Steam Web API Key
# 申请地址: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Vercel Postgres (运行 `vercel postgres create` 后自动填充)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Upstash Redis (在 upstash.com 创建数据库后填写)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
